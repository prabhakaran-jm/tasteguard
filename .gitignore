# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Secrets and local env
.env
.env.*
!.env.example

# Agent / IDE (never commit)
.cursor/
.idea/
.vscode/

# Runtime / demo artifacts
# Qloo response fixtures stay local / image-only — not in the public git tree.
recorded/*
!recorded/.gitkeep
probes/probe_report.json
*.log
.DS_Store
agent-tools/

# Frontend — commit sources + lockfile; build locally before image build
web/node_modules/
web/dist/

# Terraform local state / secret var files (infra/.gitignore also covers these)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/secrets.auto.tfvars
infra/*.auto.tfvars
!infra/terraform.tfvars.example


