# Explicit denylist for Cloud Build (do not rely on git's bare `dist/` alone —
# negation must re-admit parent dirs). Dry-run:
#   gcloud meta list-files-for-upload . | findstr web\\dist

.git/
.cursor/
.venv/
venv/
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
agent-tools/

# Secrets — never upload
.env
.env.*
!.env.example
infra/secrets.auto.tfvars
infra/*.auto.tfvars
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*

# Node toolchain
web/node_modules/
**/node_modules/

# SPA sources not needed in the image (dist is enough)
web/src/
web/public/
web/*.json
web/*.html
web/*.ts
web/*.md
!web/dist/
!web/dist/**

# Probes / recordings
probes/probe_report.json
recorded/*

# Local Python build crumbs
build/
*.egg-info/
